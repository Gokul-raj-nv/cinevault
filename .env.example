# Copy this file to .env and replace the development secret before deployment.
DATABASE_URL=postgresql://cinevault:secret@localhost:5432/cinevault_db
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
TRENDING_CACHE_TTL_SECONDS=300
GENRES_CACHE_TTL_SECONDS=3600
MOVIE_CACHE_TTL_SECONDS=600
RECOMMENDATIONS_CACHE_TTL_SECONDS=900

EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
SEMANTIC_SEARCH_ENABLED=true
